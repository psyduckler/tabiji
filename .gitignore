# Pinterest cron — state.json is mutated continuously by launchd; if it stays
# tracked in git, `git stash -u` / fast-forwards on the main worktree wipe
# in-flight mutations and the cron re-posts the same slug as duplicates.
# Canonical state lives at ~/.local/share/tabiji-pinterest/state.json
scripts/pinterest/state.json
scripts/pinterest/cron.log
scripts/pinterest/cron.stdout.log
scripts/pinterest/cron.stderr.log
