# Cloudflare Pages headers config
# Docs: https://developers.cloudflare.com/pages/platform/headers/

# Site-wide security headers. CSP is intentionally permissive on script-src
# because gtag (G-D7QHNRXLHJ) loads inline and from googletagmanager.com, and
# several pages have inline event handlers. Tighten over time.
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; img-src 'self' https://img.tabiji.ai https://www.googletagmanager.com data:; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://stats.g.doubleclick.net; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# Public JSON API endpoints — intentionally readable per llms.txt, but should
# never appear in search-engine indexes (they exist to feed agents/clients,
# not human SERPs). robots.txt already disallows /api/v1/, but many crawlers
# ignore it; X-Robots-Tag is enforceable defense-in-depth.
/api/v1/*
  X-Robots-Tag: noindex, nofollow, nosnippet, noarchive

# Same treatment for the lone raw-JSON file served outside /api/.
/compare/cards-data.json
  X-Robots-Tag: noindex, nofollow, nosnippet, noarchive

# /api/openapi.json sits outside /api/v1/* so the broader rule above doesn't
# match. Index it the same way to keep the spec out of human SERPs.
/api/openapi.json
  X-Robots-Tag: noindex, nofollow, nosnippet, noarchive

# Cache shared CSS/JS assets — 1 day; users get updates within a day.
/assets/*
  Cache-Control: public, max-age=86400, must-revalidate
