# Cloudflare Pages headers config
# Docs: https://developers.cloudflare.com/pages/platform/headers/

# Site-wide security headers.
#
# CSP is shipped in **Report-Only mode first** — it logs violations to the
# console but does not block. Inventory of legitimate cross-origin resources
# was audited from the live HTML before drafting:
#
#   <img>      : img.tabiji.ai (16k refs), images.unsplash.com (1.8k refs)
#   <script>   : googletagmanager.com (2.4k), maps.googleapis.com (395), unpkg.com (1)
#   <iframe>   : www.instagram.com (4), www.youtube.com (2)
#   <link>     : maps.googleapis.com, fonts.googleapis.com, fonts.gstatic.com,
#                unpkg.com (Leaflet CSS on /countries/)
#
# Pattern: smoke-test the live preview for a week, fix any unanticipated
# violations the report-only mode surfaces, then promote to enforced mode by
# renaming the header to `Content-Security-Policy` (drop `-Report-Only`).
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy-Report-Only: default-src 'self'; img-src 'self' data: https://img.tabiji.ai https://images.unsplash.com https://www.googletagmanager.com https://www.google-analytics.com; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://maps.googleapis.com https://maps.gstatic.com https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://stats.g.doubleclick.net; frame-src 'self' https://www.youtube.com https://www.instagram.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# Public JSON API endpoints — intentionally readable per llms.txt, but should
# never appear in search-engine indexes (they exist to feed agents/clients,
# not human SERPs). robots.txt already disallows /api/v1/, but many crawlers
# ignore it; X-Robots-Tag is enforceable defense-in-depth.
/api/v1/*
  X-Robots-Tag: noindex, nofollow, nosnippet, noarchive

# Same treatment for the lone raw-JSON file served outside /api/.
/compare/cards-data.json
  X-Robots-Tag: noindex, nofollow, nosnippet, noarchive

# /api/openapi.json sits outside /api/v1/* so the broader rule above doesn't
# match. Index it the same way to keep the spec out of human SERPs.
/api/openapi.json
  X-Robots-Tag: noindex, nofollow, nosnippet, noarchive

# Cache shared CSS/JS assets — 1 day; users get updates within a day.
/assets/*
  Cache-Control: public, max-age=86400, must-revalidate
