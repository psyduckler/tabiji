#!/bin/bash
set -euo pipefail

# Refresh managed nav/footer/head blocks before every commit.
python3 scripts/build-partials.py

git add _includes assets/shared-shell.css assets/shared-shell.js scripts/build-partials.py

git ls-files '*.html' | xargs git add --

# Reject new itinerary HTML without hero-bg assets.
staged_html=$(git diff --cached --name-only --diff-filter=A | grep '^i/.*/index\.html$' || true)

if [ -z "$staged_html" ]; then
  exit 0
fi

fail=0
while IFS= read -r html_file; do
  dir=$(dirname "$html_file")
  slug=$(basename "$dir")
  hero_png="$dir/hero-bg.png"
  hero_jpg="$dir/hero-bg.jpg"
  has_hero=false
  if git diff --cached --name-only | grep -q "^${hero_png}$" || [ -f "$hero_png" ]; then
    has_hero=true
  fi
  if git diff --cached --name-only | grep -q "^${hero_jpg}$" || [ -f "$hero_jpg" ]; then
    has_hero=true
  fi
  if [ "$has_hero" = false ]; then
    echo "❌ BLOCKED: $html_file has no hero-bg asset"
    echo "   Itinerary '$slug' must be created via fulfill-order.js (which generates hero-bg)"
    fail=1
  fi
done <<< "$staged_html"

if [ $fail -eq 1 ]; then
  echo ""
  echo "⚠️  Use fulfill-order.js to create itineraries. Manual HTML commits without hero-bg are rejected."
  exit 1
fi

exit 0
