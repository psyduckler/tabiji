#!/bin/bash
# Pre-commit hook: verify (don't rewrite) shared partials + guard itinerary assets.
#
# This used to sweep every tracked HTML file through build-partials.py and
# `git add` the lot. That caused massive cross-branch merge conflicts whenever
# two agents worked in parallel, because any partial edit (or even normal
# drift) would pull hundreds of unrelated pages into both branches' commits.
#
# The new contract:
#   - Commits only touch the files the developer actually modified.
#   - build-partials.py --check --staged-only verifies the staged subset is
#     in sync with _includes/ and fails the commit if not, with a clear fix.
#   - When _includes/*.html changes, run `scripts/sync-partials.sh` explicitly
#     to propagate across the repo.
#   - CI (.github/workflows/check-partials.yml) runs the same check across
#     every tracked HTML at PR time, so drift can't land silently.

set -euo pipefail

# 1. Verify any staged HTML has up-to-date managed blocks.
if ! python3 scripts/build-partials.py --check --staged-only; then
  exit 1
fi

# 2. Reject new itinerary HTML without hero-bg assets.
staged_html=$(git diff --cached --name-only --diff-filter=A | grep '^i/.*/index\.html$' || true)

if [ -z "$staged_html" ]; then
  exit 0
fi

fail=0
while IFS= read -r html_file; do
  dir=$(dirname "$html_file")
  slug=$(basename "$dir")
  hero_png="$dir/hero-bg.png"
  hero_jpg="$dir/hero-bg.jpg"
  has_hero=false
  if git diff --cached --name-only | grep -q "^${hero_png}$" || [ -f "$hero_png" ]; then
    has_hero=true
  fi
  if git diff --cached --name-only | grep -q "^${hero_jpg}$" || [ -f "$hero_jpg" ]; then
    has_hero=true
  fi
  if [ "$has_hero" = false ]; then
    echo "❌ BLOCKED: $html_file has no hero-bg asset"
    echo "   Itinerary '$slug' must be created via fulfill-order.js (which generates hero-bg)"
    fail=1
  fi
done <<< "$staged_html"

if [ $fail -eq 1 ]; then
  echo ""
  echo "⚠️  Use fulfill-order.js to create itineraries. Manual HTML commits without hero-bg are rejected."
  exit 1
fi

exit 0
