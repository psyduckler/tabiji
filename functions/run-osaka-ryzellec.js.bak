const fulfillOrder = require('./fulfill-order');
const fs = require('fs');
const path = require('path');

const PENDING_FILE = path.resolve(__dirname, '..', 'orders', 'pending.json');
const pending = JSON.parse(fs.readFileSync(PENDING_FILE, 'utf8'));
const order = pending.find(o => (o.id || o.orderId) === 'order_1773888790650_45bz1i');

if (!order) {
  console.error('Order not found in pending.json — may already be fulfilled');
  process.exit(1);
}

