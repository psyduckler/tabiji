<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Pinterest pin poster — runs every 15 minutes, processes the next
  manifest scam not yet posted (3 pins per run = 12 pins/hour, well
  under Pinterest's ~50 pins/hour anti-spam threshold). Drains the
  manifest until empty, then no-ops.

  Install (one-time, after the pipeline is on main and manifest is full):
    cp scripts/pinterest/ai.tabiji.pinterest-poster.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/ai.tabiji.pinterest-poster.plist

  Trigger immediately for a sanity check:
    launchctl kickstart gui/$(id -u)/ai.tabiji.pinterest-poster

  Pause posting:
    launchctl bootout gui/$(id -u) ~/Library/LaunchAgents/ai.tabiji.pinterest-poster.plist

  Watch progress:
    tail -f /Users/psy/repos/tabiji/scripts/pinterest/cron.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.tabiji.pinterest-poster</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/psy/repos/tabiji/scripts/pinterest/cron_runner.py</string>
    </array>

    <key>StartInterval</key>
    <integer>900</integer>

    <key>WorkingDirectory</key>
    <string>/Users/psy/repos/tabiji</string>

    <key>StandardOutPath</key>
    <string>/Users/psy/repos/tabiji/scripts/pinterest/cron.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/psy/repos/tabiji/scripts/pinterest/cron.stderr.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
